# ---- LLM：不设置则自动用 MockLLM（模板化中文叙述，deterministic，免费可跑） ----
LLM_PROVIDER=mock            # mock | openai_compatible
LLM_BASE_URL=                # 例如 DeepSeek: https://api.deepseek.com/v1  通义: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 企业微信：留空则用 MockWecomTool（发消息只落库，不真发） ----
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=

# ---- 飞书：留空则用 MockFeishuTool（审批只落库，靠 Dashboard 按钮模拟人工审批） ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APPROVAL_CODE=        # 需先在飞书管理后台创建审批定义，拿到 approval_code

# ---- CRM / ERP / 表单 / 埋点：当前统一用 Mock 生成合成数据，见 app/tools ----
# 接入真实系统时，在对应 tool 文件里新增一个 Real*Tool 类并在 get_*_tool() 里按环境变量切换即可
