# ---- LLM：不设置则自动用 MockLLM（模板化中文叙述，deterministic，免费可跑） ----
LLM_PROVIDER=mock            # mock | openai_compatible
LLM_BASE_URL=                # 例如 DeepSeek: https://api.deepseek.com/v1  通义: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- RAG：不设置则用 Mock（哈希伪向量 + 直通重排，零依赖可跑，仅用于验证管线逻辑） ----
# 三档可选：
#   mock         零依赖，仅验证管线逻辑，检索质量不代表真实效果
#   siliconflow  真实语义质量，纯 HTTP 调用，不用下载任何本地模型（推荐，见下方 API Key）
#   bge          真实语义质量，本地跑，需要 pip install -r requirements-rag.txt（拉 torch，模型下载）
EMBEDDER_PROVIDER=mock       # mock | siliconflow | bge
RERANKER_PROVIDER=mock       # mock | siliconflow | bge

# 硅基流动 API Key：https://cloud.siliconflow.cn 注册后在控制台获取
# BAAI/bge-m3（embedding）与 BAAI/bge-reranker-v2-m3（rerank）截至写这份配置时是免费模型，
# 以官方最新价目为准
SILICONFLOW_API_KEY=
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- Langfuse：留空则 @observe 装饰器静默不生效（不影响业务逻辑，只是没有 trace） ----
# https://cloud.langfuse.com 注册后在 Project Settings 里拿 Public/Secret Key
# LANGFUSE_BASE_URL 按你建 Project 时选的区域填：
#   EU 默认 https://cloud.langfuse.com | US https://us.cloud.langfuse.com
#   JP https://jp.cloud.langfuse.com   | HIPAA https://hipaa.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# ---- 企业微信：留空则用 MockWecomTool（发消息只落库，不真发） ----
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=

# ---- 飞书：留空则用 MockFeishuTool（审批只落库，靠 Dashboard 按钮模拟人工审批） ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APPROVAL_CODE=        # 需先在飞书管理后台创建审批定义，拿到 approval_code

# ---- CRM / ERP / 表单 / 埋点：当前统一用 Mock 生成合成数据，见 app/tools ----
# 接入真实系统时，在对应 tool 文件里新增一个 Real*Tool 类并在 get_*_tool() 里按环境变量切换即可
